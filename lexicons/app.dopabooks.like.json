{
  "lexicon": 1,
  "id": "app.dopabooks.like",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "description": "ドパBOOKsの感想（app.dopabooks.review）へのいいね。記録の名前は感想から決まり、1人1件。",
      "record": {
        "type": "object",
        "required": [
          "subject",
          "createdAt"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "format": "at-uri",
            "description": "いいねした感想のAT URI"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
