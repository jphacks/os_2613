{
  "lexicon": 1,
  "id": "app.dopabooks.review",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "description": "本ごとの公開レビュー。DIDと本IDで1件。",
      "record": {
        "type": "object",
        "required": [
          "book",
          "displayName",
          "rating",
          "text",
          "spoiler",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "book": {
            "type": "object",
            "required": [
              "id",
              "title",
              "author"
            ],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 2000,
                "maxGraphemes": 200
              },
              "title": {
                "type": "string",
                "maxLength": 2000,
                "maxGraphemes": 200
              },
              "author": {
                "type": "string",
                "maxLength": 2000,
                "maxGraphemes": 200
              }
            }
          },
          "displayName": {
            "type": "string",
            "maxLength": 400,
            "maxGraphemes": 40
          },
          "rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "text": {
            "type": "string",
            "maxLength": 10000,
            "maxGraphemes": 2000
          },
          "spoiler": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
